# One Stripe Payment Link per size, created in the Stripe dashboard.
#
# NEXT_PUBLIC_ because the browser needs them. They're public checkout URLs,
# not secrets — nothing here is sensitive.
#
# A MISSING OR EMPTY VALUE MEANS THAT SIZE IS SOLD OUT. The chip renders
# disabled and struck through, and no link is rendered for it. Blank a var and
# redeploy to kill a size mid-drop.
#
# Set each link's "After payment" to redirect back here with the size baked in:
#   https://madebybk.com/runback?ordered=1&size=m&session={CHECKOUT_SESSION_ID}
# See README.md.

NEXT_PUBLIC_STRIPE_LINK_S=
NEXT_PUBLIC_STRIPE_LINK_M=
NEXT_PUBLIC_STRIPE_LINK_L=
NEXT_PUBLIC_STRIPE_LINK_XL=
NEXT_PUBLIC_STRIPE_LINK_2XL=
